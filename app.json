{
  "id": "nl.eplucon.homey",
  "version": "1.0.0",
  "compatibility": ">=10.0.0",
  "sdk": 3,
  "platform": "local",
  "name": {
    "en": "Eplucon Heat Pump",
    "nl": "Eplucon Warmtepomp"
  },
  "description": {
    "en": "Monitor and control your Eplucon Ecoforest Heat Pump",
    "nl": "Monitor en bedien je Eplucon Ecoforest Warmtepomp"
  },
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "capabilities": {
    "month_consumed": {
      "type": "number",
      "title": {
        "en": "Prev. Month Consumed",
        "nl": "Verbruik Vorige Maand"
      },
      "units": {
        "en": "kWh"
      },
      "getable": true,
      "setable": false,
      "icon": "assets/capabilities/electricity.svg"
    },
    "month_heat": {
      "type": "number",
      "title": {
        "en": "Prev. Month Heat",
        "nl": "Warmte Vorige Maand"
      },
      "units": {
        "en": "kWh"
      },
      "getable": true,
      "setable": false,
      "icon": "assets/capabilities/fire.svg"
    },
    "month_cooling": {
      "type": "number",
      "title": {
        "en": "Prev. Month Cooling",
        "nl": "Koeling Vorige Maand"
      },
      "units": {
        "en": "kWh"
      },
      "getable": true,
      "setable": false,
      "icon": "assets/capabilities/snowflake.svg"
    }
  },
  "images": {
    "large": "assets/images/large.png",
    "small": "assets/images/small.png"
  },
  "brandColor": "#000000",
  "author": {
    "name": "Wout van den Dool",
    "email": "woutdool@gmail.com"
  },
  "contributing": {
    "donate": {}
  }
}
