{
  "id": "operation_mode_changed",
  "title": {
    "en": "Operation mode changed",
    "nl": "Bedrijfsmodus veranderd"
  },
  "titleFormatted": {
    "en": "Operation mode changed to [[state]]",
    "nl": "Bedrijfsmodus veranderd naar [[state]]"
  },
  "hint": {
    "en": "Triggers when the heat pump operation mode changes (Off, Heating, Cooling, Hot Water)",
    "nl": "Triggert wanneer de warmtepomp bedrijfsmodus verandert (Uit, Verwarming, Koeling, Warm Water)"
  },
