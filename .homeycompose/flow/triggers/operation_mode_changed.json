    },
    {
      "type": "dropdown",
      "name": "state",
      "title": {
        "en": "Mode",
        "nl": "Modus"
      },
      "values": [
        { "id": "any", "title": { "en": "Any", "nl": "Elke" } },
        { "id": "off", "title": { "en": "Off", "nl": "Uit" } },
        { "id": "heating", "title": { "en": "Heating", "nl": "Verwarming" } },
        { "id": "cooling", "title": { "en": "Cooling", "nl": "Koeling" } },
        { "id": "hotwater", "title": { "en": "Hot Water", "nl": "Warm Water" } }
      ]
    }
  ],
  "tokens": [
    {
      "name": "mode",
      "type": "string",
      "title": {
        "en": "Mode",
        "nl": "Modus"
